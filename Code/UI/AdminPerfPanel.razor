@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel
@namespace Sandbox

@* Tiny read-only FPS pill for admins. pointer-events: none so it never grabs the cursor /
   breaks mouse-look. Hidden while the full explorer menu is open (Q). *@
@if ( !AdminPerfController.IsLocalAdmin || !AdminPerfController.MiniVisible || AdminPerfController.IsExplorerOpen )
{
	return;
}

<style>
	.perf-mini {
		position: absolute;
		left: 16px;
		top: 16px;
		min-width: 188px;
		background-color: rgba(8, 14, 26, 0.9);
		border: 2px solid #4cd2a5;
		border-radius: 10px;
		padding: 8px 12px;
		flex-direction: column;
		pointer-events: none;
		z-index: 30000;
		font-family: Consolas;
	}

	.perf-mini-fps {
		font-size: 26px;
		font-weight: 900;
	}

	.perf-mini-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 20px;
	}

	.perf-mini-label { color: #9fb6cf; font-size: 14px; font-weight: 700; }
	.perf-mini-value { color: #ffffff; font-size: 14px; font-weight: 900; }
	.perf-mini-hint  { color: #6f86a0; font-size: 12px; font-weight: 700; margin-top: 4px; }
</style>

<root>
	<div class="perf-mini">
		<div class="perf-mini-fps" style="color: @FpsColor;">@FpsText FPS</div>
		<div class="perf-mini-row"><div class="perf-mini-label">frame</div><div class="perf-mini-value">@MsText ms</div></div>
		<div class="perf-mini-row"><div class="perf-mini-label">players</div><div class="perf-mini-value">@AdminPerfController.PlayerCount</div></div>
		<div class="perf-mini-row"><div class="perf-mini-label">pets</div><div class="perf-mini-value">@AdminPerfController.PetComponentCount</div></div>
		<div class="perf-mini-hint">Q = performance explorer</div>
	</div>
</root>

@code
{
	private string FpsText => AdminPerfController.Fps.ToString( "0" );
	private string MsText => AdminPerfController.FrameMs.ToString( "0.0" );

	private string FpsColor
	{
		get
		{
			var fps = AdminPerfController.Fps;
			if ( fps >= 55f ) return "#4cd2a5";
			if ( fps >= 30f ) return "#ffce54";
			return "#ff6b6b";
		}
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			AdminPerfController.IsLocalAdmin,
			AdminPerfController.MiniVisible,
			AdminPerfController.IsExplorerOpen,
			AdminPerfController.Version );
	}
}
