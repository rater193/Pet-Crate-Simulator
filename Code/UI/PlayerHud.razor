@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox


<style>
    .hover-box {
        height: 128px;
        background-color: #4b5563;
        transition: width 0.20s ease, height 0.20s ease, background-color 0.20s ease, transform 0.20s ease;
    }

    .StatBox {
        background-color: #080616dd;
        position: absolute;
        left: 100%;
        top: 32px;
        width: 480px;
        height: 64px;
        border-radius: 100%;
        color: white;
        transform: translateX(-32px) translateX(-100%);
    }

    .Icon-Cash {
        position: relative;
        left: 8px;
        width: 64px;
        height: 64px;
    }

    .StatBox-Money {
        position: relative;
        left: 16px;
        top: 4px;
        width: 396px;
        border-radius: 100%;
        height: 56px;
        background-color: #000000dd;
    }

    .Crosshair {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 8px;
        height: 8px;
        transform: translate(-50%, -50%);
        background-color: black;
    }
</style>

<root>
    <div class="Crosshair"></div>
    <div class="StatBox">
        <img class="Icon-Cash" src="ui/sandcoin_small.vtex" />
        <div class="StatBox-Money"> </div>
    </div>
</root>


@code
{

    [Property, TextArea] public string MyStringValue { get; set; } = "Hello World!";
    [Property] public int width { get; set; } = 128;

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine( MyStringValue, width );
}
