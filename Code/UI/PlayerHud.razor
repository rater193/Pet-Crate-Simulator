@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox


<style>
    .hover-box {
        height: 128px;
        background-color: #4b5563;
        transition: width 0.20s ease, height 0.20s ease, background-color 0.20s ease, transform 0.20s ease;
    }

    .StatBox {
        background-color: #080616dd;
        position: absolute;
        left: 100%;
        top: 32px;
        width: 480px;
        height: 64px;
        border-radius: 100%;
        color: white;
        transform: translateX(-32px) translateX(-100%);
    }

    .Icon-Cash {
        position: relative;
        left: 8px;
        width: 64px;
        height: 64px;
    }

    .StatBox-Money-Container {
        position: relative;
        left: 16px;
        top: 4px;
        width: 396px;
        border-radius: 100%;
        height: 56px;
        background-color: #000000dd;
    }

    .StatBox-Money-Bock {
        position: relative;
        left: 8px;
        padding-left: 15px; /* Adds space between the border and text */
        justify-content: center;
        align-items: center; /* Centers vertically */
        text-align: left; /* Keeps the text aligned to the left */
        max-width: 600px; /* Optional: prevents the block from being too wide */
        font-size: 48px;
    }

    .Crosshair {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 8px;
        height: 8px;
        transform: translate(-50%, -50%);
        background-color: black;
    }

    .HandCursor {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 52px;
        height: 52px;
        transform: translate(-50%, -50%);
        pointer-events: none;
    }

    .InteractPrompt {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translateX(-50%) translateY(60px);
        flex-direction: row;
        align-items: center;
        justify-content: center;
        height: 56px;
        padding: 6px 28px;
        background-color: #dff1ff;
        border: 4px solid #72cfff;
        border-radius: 24px;
        box-shadow: 0px 6px 16px rgba(0, 34, 78, 0.28);
        pointer-events: none;
    }

    .InteractPrompt-Text {
        color: #397da6;
        font-size: 28px;
        font-weight: 900;
        text-align: center;
        text-shadow: 1px 2px 0px rgba(255, 255, 255, 0.8);
    }

    .InventoryPrompt {
        position: absolute;
        left: -16px;
        top: 50%;
        transform: translateY(-50%);
        height: 48px;
        min-width: 212px;
        background-color: #dff1ff;
        border: 4px solid #72cfff;
        border-left-width: 0px;
        border-radius: 0px 24px 24px 0px;
        box-shadow: 0px 6px 16px rgba(0, 34, 78, 0.28);
        align-items: center;
        padding: 4px 14px 4px 6px;
        pointer-events: none;
    }

    .InventoryPrompt-Glyph {
        position: relative;
        left: 100%;
        top: 50%;
        transform: translateX(16px) translateY(-16px);
        width: 48px;
        height: 48px;
    }

    .InventoryPrompt-Text {
        color: #397da6;
        font-size: 28px;
        font-weight: 900;
        text-shadow: 1px 2px 0px rgba(255, 255, 255, 0.8);
    }

    .PTTPrompt {
        position: absolute;
        left: -16px;
        top: 0%;
        transform: translateY(0%) translateY(64px);
        height: 48px;
        min-width: 212px;
        background-color: #dff1ff;
        border: 4px solid #72cfff;
        border-left-width: 0px;
        border-radius: 0px 24px 24px 0px;
        box-shadow: 0px 6px 16px rgba(0, 34, 78, 0.28);
        align-items: center;
        padding: 4px 14px 4px 6px;
        pointer-events: none;
    }

    .PTT-Glyph {
        position: relative;
        left: 100%;
        top: 50%;
        transform: translateX(16px) translateY(-16px);
        width: 48px;
        height: 48px;
    }

    .PTT-Text {
        color: #397da6;
        font-size: 28px;
        font-weight: 900;
        text-shadow: 1px 2px 0px rgba(255, 255, 255, 0.8);
    }

    .AudioControls {
        position: absolute;
        left: 24px;
        bottom: 24px;
        flex-direction: column;
    }

    .AudioButton {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        min-width: 184px;
        height: 48px;
        margin-top: 8px;
        padding: 4px 16px;
        border: 4px solid #72cfff;
        border-radius: 24px;
        background-color: #dff1ff;
        box-shadow: 0px 6px 16px rgba(0, 34, 78, 0.28);
        pointer-events: all;
        cursor: pointer;
        transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    }

    .AudioButton:hover {
        transform: scale(1.06);
    }

    .AudioButton.muted {
        background-color: #ffe1e1;
        border-color: #ff8a8a;
    }

    .AudioButton-Label {
        color: #397da6;
        font-size: 26px;
        font-weight: 900;
        text-shadow: 1px 2px 0px rgba(255, 255, 255, 0.8);
        pointer-events: none;
    }

    .AudioButton.muted .AudioButton-Label {
        color: #b33333;
    }

    .AudioButton-State {
        color: #2f7d3f;
        font-size: 24px;
        font-weight: 900;
        pointer-events: none;
    }

    .AudioButton.muted .AudioButton-State {
        color: #b33333;
    }
</style>

<root>
    @if ( ShowHandCursor )
    {
        <img class="HandCursor" src="ui/hand.vtex" />
    }
    else
    {
        <div class="Crosshair"></div>
    }
    @if ( ShowInteractPrompt )
    {
        <div class="InteractPrompt">
            <div class="InteractPrompt-Text">@InteractPromptText</div>
        </div>
    }
    <div class="StatBox">
        <img class="Icon-Cash" src="ui/sandcoin_small.vtex" />
        <div class="StatBox-Money-Container"><div class="StatBox-Money-Bock">@RenderedMoneyValue</div></div>
    </div>
    @if ( !isPetInventoryOpen && !isPetMergerOpen && PlayerTradeController.LOCAL?.IsTradeOpen != true && PlayerTradeController.LOCAL?.IsDetailsOpen != true )
    {
        <div class="InventoryPrompt">
            <Image class="InventoryPrompt-Glyph" Texture=@InventoryInputTexture />
            <div class="InventoryPrompt-Text">Inventory</div>
        </div>
    }
    <div class="PTTPrompt">
        <Image class="PTT-Glyph" Texture=@PTTInputTexture />
        <div class="PTT-Text">Push to Talk</div>
    </div>
    <PetInventoryPanel IsOpen=@isPetInventoryOpen CloseRequested=@ClosePetInventory />
    @if ( isPetInventoryOpen )
    {
        <div class="AudioControls">
            <div class="AudioButton @(AudioSettings.MusicMuted ? "muted" : "")" onclick=@ToggleMusicMuted>
                <span class="AudioButton-Label">Music</span>
                <span class="AudioButton-State">@(AudioSettings.MusicMuted ? "Off" : "On")</span>
            </div>
            <div class="AudioButton @(AudioSettings.SoundMuted ? "muted" : "")" onclick=@ToggleSoundMuted>
                <span class="AudioButton-Label">Sound</span>
                <span class="AudioButton-State">@(AudioSettings.SoundMuted ? "Off" : "On")</span>
            </div>
        </div>
    }
    <PetMergePanel IsOpen=@isPetMergerOpen CloseRequested=@ClosePetMerger />
    <Sandbox.PlayerDetailsPanel IsOpen=@(PlayerTradeController.LOCAL?.IsDetailsOpen == true) Target=@(PlayerTradeController.LOCAL?.DetailsTarget) CloseRequested=@ClosePlayerDetails />
    <Sandbox.TradeInviteToast />
    <Sandbox.PetTradePanel />
    <Sandbox.BanNoticePanel />
    <Sandbox.PlayerNoticePanel />
</root>


@code
{
    [Property] public int RenderedMoneyValue = -1;
    [Property, TextArea] public string MyStringValue { get; set; } = "Hello World!";
    [Property] public int width { get; set; } = 128;
    public static PlayerHud SINGLETON;
    private static bool isPetInventoryOpen;
    private static bool isPetMergerOpen;
    private Texture InventoryInputTexture;
    private Texture PTTInputTexture;
    private int lastTradeUiVersion;
    private WorldInput worldInput;

    // The crosshair becomes a hand whenever the aim ray is over a clickable world-panel
    // element (shop pet cards, credits board buttons, etc.), detected via WorldInput.
    private WorldInput WorldInputComponent
    {
        get
        {
            if ( !worldInput.IsValid() )
                worldInput = Scene?.GetAllComponents<WorldInput>().FirstOrDefault();

            return worldInput;
        }
    }

    private bool IsHoveringWorldUi => WorldInputComponent?.Hovered != null;
    private bool ShowHandCursor => IsHoveringWorldUi || PlayerInteractionsController.Local?.IsHoveringInteractable == true;
    private string InteractPromptText =>
        PlayerInteractionsController.Local?.IsHoveringInteractable == true
            ? (PlayerInteractionsController.Local?.HoverPromptText ?? string.Empty)
            : CrateShopDisplay.HoverPromptText;
    private bool ShowInteractPrompt => !string.IsNullOrWhiteSpace( InteractPromptText );

    protected override void OnStart()
    {
        SINGLETON = this;
        InventoryInputTexture = Input.GetGlyph("Score", InputGlyphSize.Medium, true);
        PTTInputTexture = Input.GetGlyph("Voice", InputGlyphSize.Medium, true);
        AudioSettings.EnsureLoaded();
    }

    private void ToggleMusicMuted()
    {
        AudioSettings.ToggleMusicMuted();
        StateHasChanged();
    }

    private void ToggleSoundMuted()
    {
        AudioSettings.ToggleSoundMuted();
        StateHasChanged();
    }

    protected override void OnUpdate()
    {
        if ( Input.Pressed( "Score" ) )
        {
            isPetInventoryOpen = !isPetInventoryOpen;
            if ( isPetInventoryOpen )
            {
                isPetMergerOpen = false;
                PlayerTradeController.LOCAL?.ClosePlayerDetails();
            }
            StateHasChanged();
        }

        if ( lastTradeUiVersion != PlayerTradeController.UiVersion )
        {
            lastTradeUiVersion = PlayerTradeController.UiVersion;
            StateHasChanged();
        }
    }

    public static void OpenPetMerger()
    {
        isPetInventoryOpen = false;
        isPetMergerOpen = true;
        SINGLETON?.StateHasChanged();
    }

    private void ClosePetInventory()
    {
        isPetInventoryOpen = false;
        StateHasChanged();
    }

    private void ClosePetMerger()
    {
        isPetMergerOpen = false;
        StateHasChanged();
    }

    private void ClosePlayerDetails()
    {
        PlayerTradeController.LOCAL?.ClosePlayerDetails();
        StateHasChanged();
    }

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
    protected override int BuildHash()
    {
        return System.HashCode.Combine(
            System.HashCode.Combine(MyStringValue, width, RenderedMoneyValue, isPetInventoryOpen, isPetMergerOpen),
            InventoryInputTexture,
            PTTInputTexture,
            PlayerTradeController.UiVersion,
            System.HashCode.Combine(BanListController.NoticeVersion, PlayerNoticeController.NoticeVersion),
            AudioSettings.Version,
            ShowHandCursor,
            System.HashCode.Combine(ShowInteractPrompt, InteractPromptText)
        );
    }
}
