@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits Panel
@namespace Sandbox

@if ( !IsOpen )
	return;

<style>
	.pet-merge-shell {
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		align-items: center;
		justify-content: center;
		pointer-events: all;
		background-color: rgba(8, 14, 30, 0.38);
		font-family: Poppins;
	}

	.pet-merge-window {
		width: 1260px;
		height: 720px;
		background-color: #eef7ff;
		border: 4px solid #7bd3ff;
		border-radius: 28px;
		box-shadow: 0px 18px 48px rgba(0, 35, 70, 0.45);
		padding: 72px 30px 30px 30px;
		flex-direction: row;
		gap: 24px;
		position: relative;
	}

	.pet-merge-header {
		position: absolute;
		top: -36px;
		left: 50%;
		transform: translateX(-50%);
		width: 430px;
		height: 76px;
		background-color: #2375df;
		border: 4px solid #83d6ff;
		border-radius: 24px;
		align-items: center;
		justify-content: center;
		box-shadow: 0px 8px 20px rgba(9, 52, 116, 0.35);
	}

	.pet-merge-title {
		color: white;
		font-size: 34px;
		font-weight: 900;
		text-shadow: 2px 3px 0px rgba(0, 0, 0, 0.25);
	}

	.pet-merge-close {
		position: absolute;
		right: -32px;
		top: -30px;
		width: 64px;
		height: 64px;
		border-radius: 18px;
		background-color: #2375df;
		border: 4px solid #83d6ff;
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 42px;
		font-weight: 900;
		pointer-events: all;
		transition: transform 0.08s ease;
	}

	.pet-merge-close:hover {
		transform: scale(1.12);
	}

	.pet-merge-library {
		width: 720px;
		height: 100%;
		flex-direction: column;
	}

	.pet-merge-side {
		flex-grow: 1;
		height: 100%;
		background-color: #dff1ff;
		border: 3px solid rgba(80, 170, 230, 0.5);
		border-radius: 20px;
		padding: 18px;
		flex-direction: column;
		align-items: center;
	}

	.pet-merge-section-title {
		color: #334766;
		font-size: 24px;
		font-weight: 900;
		margin-bottom: 14px;
	}

	.pet-merge-grid {
		flex-grow: 1;
		width: 100%;
		flex-direction: row;
		flex-wrap: wrap;
		overflow-y: scroll;
		gap: 12px;
		align-content: flex-start;
		justify-content: center;
		padding-right: 8px;
	}

	.pet-merge-card {
		width: 144px;
		height: 170px;
		border-radius: 14px;
		background-color: #37adf4;
		border: 4px solid white;
		box-shadow: 0px 6px 13px rgba(21, 52, 86, 0.22);
		padding: 8px;
		flex-direction: column;
		align-items: center;
		pointer-events: all;
		position: relative;
		overflow: hidden;
	}

	.pet-merge-card.selected {
		background-color: #54c943;
		box-shadow: 0px 8px 22px rgba(13, 116, 42, 0.34);
	}

	.pet-merge-card.equipped {
		background-color: #2f97dd;
	}

	.pet-merge-card:hover {
		transform: scale(1.03);
	}

	.pet-merge-icon {
		width: 76px;
		height: 76px;
		border-radius: 20px;
		background-color: rgba(255, 255, 255, 0.32);
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 40px;
		font-weight: 900;
		margin: 8px auto;
		text-shadow: 1px 3px 0px rgba(0, 0, 0, 0.22);
	}

	.pet-merge-preview {
		width: 72px;
		height: 72px;
	}

	.pet-merge-name {
		color: white;
		font-size: 18px;
		font-weight: 900;
		text-align: center;
		text-shadow: 1px 2px 0px rgba(0, 0, 0, 0.25);
		max-width: 120px;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.pet-merge-rarity {
		color: rgba(255, 255, 255, 0.9);
		font-size: 13px;
		font-weight: 900;
		text-align: center;
		text-shadow: 1px 2px 0px rgba(0, 0, 0, 0.24);
		margin-top: 4px;
	}

	.pet-merge-selected-area {
		width: 430px;
		height: 100%;
		flex-direction: column;
		align-items: center;
	}

	.pet-merge-slots {
		width: 100%;
		height: 250px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 18px;
		margin-top: 14px;
		position: relative;
	}

	.pet-merge-slot {
		width: 122px;
		height: 156px;
		border-radius: 18px;
		background-color: rgba(255, 255, 255, 0.42);
		border: 4px solid rgba(77, 115, 155, 0.55);
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.pet-merge-slot.filled {
		background-color: #37adf4;
		box-shadow: 0px 6px 13px rgba(21, 52, 86, 0.22);
	}

	.pet-merge-slot.merging {
		z-index: 3;
	}

	.pet-merge-slot-blackout {
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		background-color: black;
		opacity: @MergeBlackoutOpacity;
		z-index: 5;
	}

	.pet-merge-slot-empty {
		color: #64819e;
		font-size: 44px;
		font-weight: 900;
	}

	.pet-merge-result {
		height: 70px;
		color: #334766;
		font-size: 24px;
		font-weight: 900;
		text-align: center;
		align-items: center;
		justify-content: center;
	}

	.pet-merge-button {
		width: 310px;
		height: 82px;
		border-radius: 18px;
		border: 4px solid white;
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 32px;
		font-weight: 900;
		text-shadow: 1px 3px 0px rgba(0, 0, 0, 0.28);
		pointer-events: all;
		box-shadow: 0px 9px 0px rgba(0, 0, 0, 0.24);
	}

	.pet-merge-button.valid {
		background-color: #39c957;
	}

	.pet-merge-button.invalid {
		background-color: #e84d4d;
	}

	.pet-merge-button.merging {
		background-color: #ffd740;
		color: #6f4c00;
	}

	.pet-merge-effect {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 230px;
		height: 230px;
		transform: translateX(-50%) translateY(-50%) scale(@MergeBurstScale) rotate(@MergeBurstRotationdeg);
		opacity: @MergeBurstOpacity;
		z-index: 8;
		pointer-events: none;
	}

	.pet-merge-burst-core {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 88px;
		height: 88px;
		border-radius: 999px;
		background-color: rgba(255, 245, 166, 0.86);
		border: 7px solid rgba(255, 255, 255, 0.92);
		box-shadow: 0px 0px 22px rgba(255, 215, 64, 0.88), 0px 0px 48px rgba(61, 143, 255, 0.42);
		transform: translateX(-50%) translateY(-50%);
	}

	.pet-merge-particle {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 18px;
		height: 18px;
		border-radius: 999px;
		box-shadow: 0px 0px 10px rgba(255, 255, 255, 0.72);
	}

	.ancestral {
		box-shadow: 0px 0px 0px 3px #ff3434, 0px 0px 18px #ffd740, 0px 0px 32px #3d8fff;
	}
</style>

<root>
	<div class="pet-merge-shell">
		<div class="pet-merge-window">
			<div class="pet-merge-header">
				<div class="pet-merge-title">Pet Forge</div>
			</div>
			<div class="pet-merge-close" onclick=@Close>X</div>

			<div class="pet-merge-library">
				<div class="pet-merge-section-title">Select Pets</div>
				<div class="pet-merge-grid">
					@foreach ( var pet in AllPets )
					{
						<div class="@GetPetCardClass( pet )" style="@pet.BorderStyle" onclick=@(() => ToggleSelectedPet( pet.SlotIndex ))>
							<div class="pet-merge-icon">
								@if ( pet.PreviewTexture != null )
								{
									<Image class="pet-merge-preview" Texture=@pet.PreviewTexture />
								}
								else
								{
									@pet.IconText
								}
							</div>
							<div class="pet-merge-name">@pet.DisplayName</div>
							<div class="pet-merge-rarity">@pet.Rarity</div>
						</div>
					}
				</div>
			</div>

			<div class="pet-merge-side">
				<div class="pet-merge-section-title">Merge Slots</div>
				<div class="pet-merge-slots">
					@for ( var i = 0; i < 3; i++ )
					{
						var pet = GetSelectedPetView( i );
						<div class="@GetSlotClass( pet )" style="@GetSlotStyle( pet, i )">
							@if ( pet != null )
							{
								<div class="pet-merge-icon">
									@if ( pet.PreviewTexture != null )
									{
										<Image class="pet-merge-preview" Texture=@pet.PreviewTexture />
									}
									else
									{
										@pet.IconText
									}
								</div>
								@if ( isMerging )
								{
									<div class="pet-merge-slot-blackout"></div>
								}
							}
							else
							{
								<div class="pet-merge-slot-empty">+</div>
							}
						</div>
					}
					@if ( isMerging )
					{
						<div class="pet-merge-effect">
							<div class="pet-merge-burst-core"></div>
							@for ( var particleIndex = 0; particleIndex < MergeParticleCount; particleIndex++ )
							{
								<div class="pet-merge-particle" style="@GetMergeParticleStyle( particleIndex )"></div>
							}
						</div>
					}
				</div>
				<div class="pet-merge-result">@MergeStatusText</div>
				<div class="@MergeButtonClass" onclick=@StartMerge>@MergeButtonText</div>
			</div>
		</div>
	</div>
</root>

@code
{
	private const float MergeLiftDuration = 1f;
	private const float MergeConvergeDuration = 0.34f;
	private const float MergeBurstDuration = 0.42f;
	private const float MergeReturnDuration = 0.42f;
	private const float MergeConsumeTime = MergeLiftDuration + MergeConvergeDuration;
	private const float MergeDuration = MergeLiftDuration + MergeConvergeDuration + MergeBurstDuration + MergeReturnDuration;
	private const int MergeParticleCount = 24;
	private const string DefaultMergeSlotBorderStyle = "border-color: rgba(77, 115, 155, 0.55);";

	public bool IsOpen { get; set; }
	public Action CloseRequested { get; set; }

	private readonly List<int> selectedSlotIndexes = new();
	private bool isMerging;
	private bool mergeConsumed;
	private float mergeStartTime;
	private float mergeAnimationTime;

	private PlayerData LocalPlayerData => PlayerData.LOCALDATA;
	private Inventory Inventory => LocalPlayerData?.inventory;
	private List<MergePetViewModel> AllPets => BuildPetList();
	private bool CanMergeSelection => Inventory?.CanMergePets( selectedSlotIndexes ) == true;
	private string MergeButtonClass => $"pet-merge-button {(isMerging ? "merging" : CanMergeSelection ? "valid" : "invalid")}";
	private string MergeButtonText => isMerging ? "Merging..." : "Merge";
	private string MergeStatusText => GetMergeStatusText();
	private float MergeLiftProgress => Smooth01( Saturate( mergeAnimationTime / MergeLiftDuration ) );
	private float MergeConvergeProgress => Smooth01( Saturate( (mergeAnimationTime - MergeLiftDuration) / MergeConvergeDuration ) );
	private float MergeBurstProgress => Smooth01( Saturate( (mergeAnimationTime - MergeLiftDuration - MergeConvergeDuration) / MergeBurstDuration ) );
	private float MergeReturnProgress => Smooth01( Saturate( (mergeAnimationTime - MergeLiftDuration - MergeConvergeDuration - MergeBurstDuration) / MergeReturnDuration ) );
	private string MergeBlackoutOpacity => $"{GetMergeBlackoutOpacity():0.###}";
	private string MergeBurstScale => $"{0.35f + (MergeBurstProgress * 1.35f) - (MergeReturnProgress * 0.38f):0.###}";
	private string MergeBurstRotationdeg => $"{mergeAnimationTime * 360f:0.##}deg";
	private string MergeBurstOpacity => $"{Saturate( MathF.Sin( MergeBurstProgress * MathF.PI ) * 1.15f ) * (1f - MergeReturnProgress):0.###}";

	public override void Tick()
	{
		base.Tick();

		if ( !IsOpen )
			return;

		if ( isMerging )
		{
			mergeAnimationTime = Time.Now - mergeStartTime;
			if ( !mergeConsumed && mergeAnimationTime >= MergeConsumeTime )
			{
				ConsumeMergeSelection();
			}

			if ( mergeAnimationTime >= MergeDuration )
			{
				FinishMerge();
			}

			StateHasChanged();
		}
	}

	private void Close()
	{
		if ( isMerging )
			return;

		selectedSlotIndexes.Clear();
		CloseRequested?.Invoke();
	}

	private void ToggleSelectedPet( int slotIndex )
	{
		if ( isMerging )
			return;

		if ( selectedSlotIndexes.Contains( slotIndex ) )
		{
			selectedSlotIndexes.Remove( slotIndex );
		}
		else if ( selectedSlotIndexes.Count < 3 )
		{
			selectedSlotIndexes.Add( slotIndex );
		}

		StateHasChanged();
	}

	private void StartMerge()
	{
		if ( isMerging || !CanMergeSelection )
			return;

		isMerging = true;
		mergeConsumed = false;
		mergeStartTime = Time.Now;
		mergeAnimationTime = 0f;
		StateHasChanged();
	}

	private void ConsumeMergeSelection()
	{
		mergeConsumed = true;

		if ( Inventory?.TryMergePets( selectedSlotIndexes, out _ ) == true )
		{
			selectedSlotIndexes.Clear();
			return;
		}

		isMerging = false;
		mergeAnimationTime = 0f;
	}

	private void FinishMerge()
	{
		isMerging = false;
		mergeConsumed = false;
		mergeAnimationTime = 0f;

		StateHasChanged();
	}

	private MergePetViewModel GetSelectedPetView( int selectedIndex )
	{
		if ( selectedIndex < 0 || selectedIndex >= selectedSlotIndexes.Count )
			return null;

		var slotIndex = selectedSlotIndexes[selectedIndex];
		return AllPets.FirstOrDefault( pet => pet.SlotIndex == slotIndex );
	}

	private string GetSlotClass( MergePetViewModel pet )
	{
		return $"pet-merge-slot {(pet != null ? "filled" : "")} {(isMerging ? "merging" : "")}";
	}

	private string GetSlotStyle( MergePetViewModel pet, int selectedIndex )
	{
		var borderStyle = pet?.BorderStyle ?? DefaultMergeSlotBorderStyle;

		if ( !isMerging )
			return borderStyle;

		return $"{borderStyle} transform: {GetMergeSlotTransform( selectedIndex )}; opacity: {GetMergeSlotOpacity()};";
	}

	private string GetMergeSlotTransform( int selectedIndex )
	{
		var lift = MergeLiftProgress;
		var converge = MergeConvergeProgress;
		var burst = MergeBurstProgress;
		var reset = 1f - MergeReturnProgress;
		var side = selectedIndex == 0 ? 1f : selectedIndex == 2 ? -1f : 0f;
		var x = side * 140f * converge * reset;
		var y = (selectedIndex == 1
			? -8f * converge
			: (-64f * lift) + (14f * converge)) * reset;
		var scaleOffset = selectedIndex == 1
			? 1f + (0.08f * converge) - (0.16f * burst)
			: 1f + (0.04f * lift) - (0.2f * converge) - (0.12f * burst);
		var scale = Lerp( 1f, scaleOffset, reset );

		return $"translateX({x:0.##}px) translateY({y:0.##}px) scale({scale:0.###})";
	}

	private string GetMergeSlotOpacity()
	{
		var faded = 1f - (MergeBurstProgress * 0.72f);
		return $"{Lerp( faded, 1f, MergeReturnProgress ):0.###}";
	}

	private float GetMergeBlackoutOpacity()
	{
		var fadedIn = Saturate( (MergeConvergeProgress * 0.82f) + (MergeBurstProgress * 0.18f) );
		return Lerp( fadedIn, 0f, MergeReturnProgress );
	}

	private string GetMergeParticleStyle( int index )
	{
		var progress = MergeBurstProgress;
		var angle = ((MathF.PI * 2f) / MergeParticleCount) * index;
		var stagger = (index % 5) * 0.035f;
		var distanceProgress = Saturate( progress + stagger );
		var distance = 26f + (118f * distanceProgress);
		var wobble = MathF.Sin( (mergeAnimationTime * 18f) + index ) * 8f * progress;
		var x = MathF.Cos( angle ) * distance;
		var y = MathF.Sin( angle ) * (distance * 0.72f) + wobble;
		var size = 10f + ((index % 4) * 3f);
		var opacity = Saturate( MathF.Sin( progress * MathF.PI ) * (0.72f + ((index % 3) * 0.12f)) );
		var scale = 0.45f + (progress * 0.95f);
		var color = GetMergeParticleColor( index );

		return $"width: {size:0.##}px; height: {size:0.##}px; background-color: {color}; opacity: {opacity:0.###}; transform: translateX({x:0.##}px) translateY({y:0.##}px) scale({scale:0.###});";
	}

	private string GetMergeParticleColor( int index )
	{
		return (index % 6) switch
		{
			0 => "#ffffff",
			1 => "#ffd740",
			2 => "#7bd3ff",
			3 => "#b356ff",
			4 => "#4bff5c",
			_ => "#ff8f28"
		};
	}

	private static float Saturate( float value )
	{
		return Math.Clamp( value, 0f, 1f );
	}

	private static float Smooth01( float value )
	{
		var t = Saturate( value );
		return t * t * (3f - (2f * t));
	}

	private static float Lerp( float start, float end, float amount )
	{
		return start + ((end - start) * Saturate( amount ));
	}

	private string GetPetCardClass( MergePetViewModel pet )
	{
		var classes = $"pet-merge-card {pet.Rarity.GetCssClass()}";
		if ( pet.IsSelected )
			classes += " selected";
		if ( pet.IsEquipped )
			classes += " equipped";

		return classes;
	}

	private string GetMergeStatusText()
	{
		if ( isMerging )
			return "Combining power...";

		if ( selectedSlotIndexes.Count == 0 )
			return "Pick 3 matching pets";

		if ( selectedSlotIndexes.Count < 3 )
			return $"{selectedSlotIndexes.Count} / 3 selected";

		return CanMergeSelection ? $"Ready: {GetSelectedPetView( 0 )?.Rarity.NextRarity()}" : "Pets must match";
	}

	private List<MergePetViewModel> BuildPetList()
	{
		var pets = new List<MergePetViewModel>();
		var inventory = Inventory;
		if ( inventory == null )
			return pets;

		for ( var i = 0; i < inventory.Slots.Count; i++ )
		{
			var slot = inventory.GetPet( i );
			if ( !slot.IsValid() )
				continue;

			var petPrefab = slot.GetPetPrefab();
			var petComponent = petPrefab?.GetComponent<PetComponent>() ?? petPrefab?.GetComponentInChildren<PetComponent>();
			var displayName = !string.IsNullOrWhiteSpace( petComponent?.DisplayName ) ? petComponent.DisplayName : slot.DisplayName;

			pets.Add( new MergePetViewModel
			{
				SlotIndex = i,
				DisplayName = string.IsNullOrWhiteSpace( displayName ) ? "Pet" : displayName,
				Rarity = slot.Rarity,
				IsSelected = selectedSlotIndexes.Contains( i ),
				IsEquipped = inventory.IsPetEquipped( i ),
				PreviewTexture = PetPreviewRenderer.Instance?.GetPreviewTexture( slot.PetPrefabPath, petPrefab )
			} );
		}

		return pets;
	}

	protected override int BuildHash()
	{
		var inventory = Inventory;
		var slotHash = 0;
		if ( inventory != null )
		{
			foreach ( var slot in inventory.Slots )
			{
				slotHash = HashCode.Combine( slotHash, slot?.DisplayName, slot?.PetPrefabPath, slot?.Rarity );
			}
		}

		foreach ( var selectedIndex in selectedSlotIndexes )
		{
			slotHash = HashCode.Combine( slotHash, selectedIndex );
		}

		return HashCode.Combine( IsOpen, inventory?.Count ?? 0, slotHash, isMerging, (int)(mergeAnimationTime * 30f), PetPreviewRenderer.PreviewVersion );
	}

	private sealed class MergePetViewModel
	{
		public int SlotIndex { get; set; }
		public string DisplayName { get; set; }
		public PetRarity Rarity { get; set; }
		public bool IsSelected { get; set; }
		public bool IsEquipped { get; set; }
		public Texture PreviewTexture { get; set; }
		public string BorderStyle => $"border-color: {Rarity.GetCssColor()};";
		public string IconText => string.IsNullOrWhiteSpace( DisplayName ) ? "?" : DisplayName[..1].ToUpperInvariant();
	}
}
