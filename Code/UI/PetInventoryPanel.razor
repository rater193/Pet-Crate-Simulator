@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits Panel
@namespace Sandbox

@if ( !IsOpen )
	return;

<style>
	.pet-inventory-shell {
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		align-items: center;
		justify-content: center;
		pointer-events: all;
		background-color: rgba(8, 14, 30, 0.35);
		font-family: Poppins;
	}

	.pet-inventory-window {
		width: 1180px;
		height: 720px;
		background-color: #eef7ff;
		border: 4px solid #7bd3ff;
		border-radius: 28px;
		box-shadow: 0px 18px 48px rgba(0, 35, 70, 0.45);
		padding: 72px 28px 26px 28px;
		flex-direction: column;
		position: relative;
	}

	.pet-inventory-header {
		position: absolute;
		top: -36px;
		left: 50%;
		transform: translateX(-50%);
		width: 450px;
		height: 76px;
		background-color: #2375df;
		border: 4px solid #83d6ff;
		border-radius: 24px;
		align-items: center;
		justify-content: center;
		box-shadow: 0px 8px 20px rgba(9, 52, 116, 0.35);
	}

	.pet-inventory-title {
		color: white;
		font-size: 36px;
		font-weight: 900;
		text-shadow: 2px 3px 0px rgba(0, 0, 0, 0.25);
	}

	.pet-inventory-close {
		position: absolute;
		right: -32px;
		top: -30px;
		width: 64px;
		height: 64px;
		border-radius: 18px;
		background-color: #2375df;
		border: 4px solid #83d6ff;
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 42px;
		font-weight: 900;
		pointer-events: all;
		transition: transform 0.08s ease;
	}

	.pet-inventory-close:hover {
		transform: scale(1.12);
	}

	.pet-inventory-equipped {
		height: 178px;
		min-height: 178px;
		flex-direction: column;
		border-bottom: 2px solid rgba(68, 94, 130, 0.18);
		padding-bottom: 20px;
		margin-bottom: 18px;
	}

	.pet-section-title {
		color: #334766;
		font-size: 22px;
		font-weight: 800;
		margin-bottom: 12px;
	}

	.pet-section-title-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.pet-section-actions {
		flex-direction: row;
		align-items: center;
		gap: 12px;
	}

	.pet-sort-controls {
		flex-direction: row;
		align-items: center;
		gap: 8px;
	}

	.pet-sort-button {
		height: 42px;
		padding: 0px 14px;
		border-radius: 12px;
		background-color: #d9edff;
		border: 3px solid #64c7f5;
		color: #36516e;
		font-size: 15px;
		font-weight: 900;
		align-items: center;
		justify-content: center;
		pointer-events: all;
		transition: transform 0.08s ease, background-color 0.1s ease;
        transform: translateY(-16px);
	}

	.pet-sort-button:hover {
		transform: scale(1.06);
		background-color: #ecf8ff;
	}

	.pet-sort-button.active {
		background-color: #2375df;
		color: white;
		border-color: #2375df;
	}

	.pet-sort-direction {
		min-width: 104px;
	}

	.pet-section-title-row .pet-section-title {
		margin-bottom: 0px;
	}

	.pet-inventory-count {
		color: #55708f;
		font-size: 18px;
		font-weight: 800;
	}

	.pet-delete-toggle {
		width: 54px;
		height: 48px;
		border-radius: 14px;
		background-color: #d9edff;
		border: 3px solid #64c7f5;
		align-items: center;
		justify-content: center;
		pointer-events: all;
		box-shadow: none;
		transition: transform 0.08s ease;
        transform: translateY(-16px);
	}

	.pet-delete-toggle:hover {
		transform: translateY(-16px) scale(1.1);
	}

	.pet-delete-toggle.active {
		background-color: #ffefef;
		border-color: #ef4a4a;
		box-shadow: none;
	}

	.pet-trash-icon {
		width: 30px;
		height: 30px;
	}

	.pet-delete-toggle.active .pet-trash-icon {
		opacity: 0.82;
		transform: scale(1.08);
	}

	.pet-equipped-list {
		height: 118px;
		min-height: 118px;
		flex-direction: row;
		gap: 14px;
		justify-content: center;
		align-items: center;
		flex-wrap: nowrap;
		overflow-x: scroll;
		overflow-y: hidden;
	}

	.pet-equipped-card {
		width: 164px;
		min-width: 164px;
		max-width: 164px;
		height: 96px;
		min-height: 96px;
		max-height: 96px;
		flex-shrink: 0;
		background-color: #d9edff;
		border: 3px solid #60c7ff;
		border-radius: 14px;
		padding: 10px;
		align-items: center;
		pointer-events: all;
		position: relative;
		overflow: hidden;
	}

	.pet-equipped-card:hover {
		border-color: #ef5b5b;
	}

	.pet-equipped-card:hover .pet-action-overlay {
		opacity: 1;
	}

	.pet-avatar {
		width: 58px;
		height: 58px;
		min-width: 58px;
		max-width: 58px;
		min-height: 58px;
		max-height: 58px;
		flex-shrink: 0;
		border-radius: 14px;
		background-color: #2aa8f4;
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 28px;
		font-weight: 900;
		margin-right: 10px;
	}

	.pet-avatar-preview {
		width: 54px;
		height: 54px;
	}

	.pet-equipped-name {
		color: #253c5b;
		font-size: 19px;
		font-weight: 900;
		width: 76px;
		max-height: 44px;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.pet-equipped-action {
		position: absolute;
		right: 12px;
		bottom: 8px;
		color: #e84253;
		font-size: 14px;
		font-weight: 800;
	}

	.pet-inventory-body {
		flex-grow: 1;
		flex-direction: column;
	}

	.pet-library-scroll-area {
		flex-grow: 1;
		flex-direction: row;
		min-height: 0px;
	}

	.pet-grid {
		flex-grow: 1;
		height: 100%;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
		align-content: flex-start;
		overflow-y: scroll;
		overflow-x: hidden;
		padding-right: 14px;
	}

	.pet-scrollbar {
		width: 64px;
		height: 100%;
		align-items: center;
		justify-content: center;
		margin-left: 10px;
		position: relative;
	}

	.pet-scrollbar-track {
		width: 14px;
		top: 28px;
		bottom: 28px;
		position: absolute;
		background-color: #d8eeff;
		border: 4px solid #64c7f5;
		border-radius: 999px;
		box-shadow: none;
	}

	.pet-scrollbar-cap {
		position: absolute;
		left: 50%;
		width: 34px;
		height: 34px;
		border-radius: 999px;
		background-color: #dff1ff;
		border: 5px solid #64c7f5;
		transform: translateX(-50%);
	}

	.pet-scrollbar-cap.top {
		top: 12px;
	}

	.pet-scrollbar-cap.bottom {
		bottom: 12px;
	}

	.pet-scrollbar-thumb {
		position: absolute;
		left: 50%;
		width: 42px;
		min-height: 42px;
		border-radius: 999px;
		background-color: #dff1ff;
		border: 5px solid #64c7f5;
		transform: translateX(-50%);
		box-shadow: none;
	}

	.pet-card {
		width: 150px;
		height: 176px;
		border-radius: 14px;
		background-color: #37adf4;
		border: 4px solid rgba(255, 255, 255, 0.65);
		box-shadow: 0px 6px 13px rgba(21, 52, 86, 0.22);
		padding: 10px;
		flex-direction: column;
		pointer-events: all;
		position: relative;
		overflow: hidden;
		transition: background-color 0.14s ease, border-color 0.08s ease, box-shadow 0.08s ease;
	}

	.pet-card.equipped {
		background-color: #54c943;
		border-color: #ffe16a;
	}

	.pet-card:hover {
		border-color: #4beb68;
		box-shadow: 0px 7px 18px rgba(13, 116, 42, 0.34);
	}

	.pet-card.delete-mode {
		background-color: rgba(255, 255, 255, 0.9);
	}

	.pet-card.delete-mode:hover {
		background-color: rgba(236, 36, 48, 0.34);
		border-color: #ff4a4a;
		box-shadow: 0px 8px 24px rgba(160, 15, 25, 0.36);
	}

	.pet-card.pending-delete {
		background-color: rgba(236, 36, 48, 0.5);
		border-color: #ff2323;
		box-shadow: 0px 8px 28px rgba(160, 15, 25, 0.46);
	}

	.pet-card.deleting {
		z-index: 20;
	}

	.pet-card.equipped:hover {
		border-color: #ef5b5b;
		box-shadow: 0px 7px 18px rgba(142, 18, 18, 0.34);
	}

	.pet-card.ancestral,
	.pet-equipped-card.ancestral {
		box-shadow: 0px 0px 0px 3px #ff3434, 0px 0px 16px #ffd740, 0px 0px 28px #3d8fff;
	}

	.pet-card:hover .pet-action-overlay {
		opacity: 1;
	}

	.pet-action-overlay {
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		border-radius: 10px;
		align-items: center;
		justify-content: center;
		font-size: 30px;
		font-weight: 900;
		text-transform: uppercase;
		text-stroke: 2px rgba(255, 255, 255, 0.58);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.08s ease;
		z-index: 10;
	}

	.pet-action-overlay.max-equipped {
		font-size: 22px;
		text-align: center;
		padding: 12px;
	}

	.pet-action-overlay.equip {
		background-color: rgba(62, 225, 92, 0.5);
		color: #075f25;
	}

	.pet-action-overlay.unequip {
		background-color: rgba(240, 72, 72, 0.5);
		color: #7b1010;
	}

	.pet-action-overlay.max-equipped {
		background-color: rgba(240, 72, 72, 0.5);
		color: #7b1010;
	}

	.pet-action-overlay.delete {
		background-color: rgba(236, 36, 48, 0.42);
		color: #8b0e17;
		opacity: 0;
	}

	.pet-card.delete-mode:hover .pet-action-overlay.delete,
	.pet-card.pending-delete .pet-action-overlay.delete,
	.pet-card.deleting .pet-action-overlay.delete {
		opacity: 1;
	}

	.pet-card-status {
		color: white;
		font-size: 14px;
		font-weight: 900;
		text-shadow: 1px 2px 0px rgba(0, 0, 0, 0.25);
		align-self: flex-end;
	}

	.pet-card-icon {
		width: 74px;
		height: 74px;
		border-radius: 20px;
		background-color: rgba(255, 255, 255, 0.32);
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 42px;
		font-weight: 900;
		margin: 10px auto 8px auto;
		text-shadow: 1px 3px 0px rgba(0, 0, 0, 0.22);
	}

	.pet-card-preview {
		width: 72px;
		height: 72px;
	}

	.pet-card-name {
		color: white;
		font-size: 20px;
		font-weight: 900;
		text-align: center;
		text-shadow: 1px 2px 0px rgba(0, 0, 0, 0.25);
	}

	.pet-card-stats {
		margin-top: 6px;
		flex-direction: column;
		color: rgba(255, 255, 255, 0.9);
		font-size: 13px;
		font-weight: 700;
		text-align: center;
	}

	.pet-empty-state {
		height: 100%;
		align-items: center;
		justify-content: center;
		color: #68809e;
		font-size: 20px;
		font-weight: 700;
	}

	.pet-empty-library {
		flex-grow: 1;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		color: #68809e;
	}

	.pet-empty-title {
		font-size: 30px;
		font-weight: 900;
	}

	.pet-empty-copy {
		font-size: 18px;
		font-weight: 700;
		margin-top: 6px;
	}
</style>

<root>
	<div class="pet-inventory-shell">
		<div class="pet-inventory-window">
			<div class="pet-inventory-header">
				<div class="pet-inventory-title">Pets Inventory</div>
			</div>
			<div class="pet-inventory-close" onclick=@Close>X</div>

			<div class="pet-inventory-equipped">
				<div class="pet-section-title">@EquippedCount / @MaxEquipped Equipped</div>
				<div class="pet-equipped-list">
					@if ( EquippedPets.Count == 0 )
					{
						<div class="pet-empty-state">No pets equipped</div>
					}
					else
					{
						@foreach ( var pet in EquippedPets )
						{
							<div class="@GetEquippedPetCardClass( pet )" style="@pet.RarityBorderStyle" onclick=@(() => TogglePet( pet.SlotIndex ))>
								<div class="pet-avatar">
									@if ( pet.PreviewTexture != null )
									{
										<Image class="pet-avatar-preview" Texture=@pet.PreviewTexture />
									}
									else
									{
										@pet.IconText
									}
								</div>
								<div class="pet-equipped-name">@pet.DisplayName</div>
								<div class="pet-equipped-action"></div>
								<div class="pet-action-overlay unequip">Unequip</div>
							</div>
						}
					}
				</div>
			</div>

			<div class="pet-inventory-body">
				<div class="pet-section-title-row">
					<div class="pet-section-title">Your Pets</div>
					<div class="pet-sort-controls">
						<div class="@GetSortButtonClass( PetInventorySortMode.Rarity )" onclick=@(() => SetSortMode( PetInventorySortMode.Rarity ))>Sort by rarity</div>
						<div class="@GetSortButtonClass( PetInventorySortMode.Name )" onclick=@(() => SetSortMode( PetInventorySortMode.Name ))>Sort by name</div>
						<div class="pet-sort-button pet-sort-direction" onclick=@ToggleSortDirection>@SortDirectionText</div>
					</div>
					<div class="pet-section-actions">
						<div class="@DeleteToggleClass" onclick=@ToggleDeleteMode>
							<img class="pet-trash-icon" src="ui/icons/icon_trashcan.vtex" />
						</div>
						<div class="pet-inventory-count">@InventoryPetCount / @InventoryCapacity Pets</div>
					</div>
				</div>
				@if ( AllPets.Count == 0 )
				{
					<div class="pet-empty-library">
						<div class="pet-empty-title">No pets yet</div>
						<div class="pet-empty-copy">Pets you collect will appear here.</div>
					</div>
				}
				else
				{
					<div class="pet-library-scroll-area">
						<div class="pet-grid" @ref=PetGridPanel>
							@foreach ( var pet in AllPets )
							{
								<div class="@GetPetCardClass( pet )" style="@GetPetCardStyle( pet )" onclick=@(() => HandlePetCardClicked( pet.SlotIndex ))>
									<div class="pet-card-status">@GetStatusText( pet )</div>
									<div class="pet-card-icon">
										@if ( pet.PreviewTexture != null )
										{
											<Image class="pet-card-preview" Texture=@pet.PreviewTexture />
										}
										else
										{
											@pet.IconText
										}
									</div>
									<div class="pet-card-name">@pet.DisplayName</div>
									<div class="pet-card-stats">
										<span>Coins x@(pet.CoinMultiplierText)</span>
										<span>Damage @(pet.Damage)</span>
									</div>
									<div class="@GetPetActionOverlayClass( pet )">@GetHoverActionText( pet )</div>
								</div>
							}
						</div>
						@if ( ShouldShowScrollbar )
						{
							<div class="pet-scrollbar">
								<div class="pet-scrollbar-track">
									<div class="pet-scrollbar-thumb" style="@ScrollbarThumbStyle"></div>
								</div>
								<div class="pet-scrollbar-cap top"></div>
								<div class="pet-scrollbar-cap bottom"></div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</div>
</root>

@code
{
	public bool IsOpen { get; set; }
	public Action CloseRequested { get; set; }

	private const float ScrollTrackPadding = 28f;
	private const float MinScrollbarThumbHeight = 42f;
	private const float DeleteAnimationDuration = 0.98f;
	private const float DeleteCollapseStart = 0.68f;
	private const float DeleteModeSettleDuration = 0.32f;
	private const float SortAnimationDuration = 0.34f;

	private Panel PetGridPanel { get; set; }
	private float lastScrollRatio;
	private float lastThumbHeight;
	private bool isDeleteMode;
	private bool isDeleteModeSettling;
	private int pendingDeleteSlotIndex = -1;
	private int deletingSlotIndex = -1;
	private float deleteStartTime;
	private float deleteAnimationTime;
	private float deleteModeSettleStartTime;
	private float deleteModeSettleTime;
	private PetInventorySortMode sortMode = PetInventorySortMode.Rarity;
	private bool sortAscending = true;
	private float sortAnimationStartTime;
	private float sortAnimationTime = SortAnimationDuration;

	private PlayerData LocalPlayerData => PlayerData.LOCALDATA;
	private Inventory Inventory => LocalPlayerData?.inventory;
	private int MaxEquipped => LocalPlayerData?.GetComponent<PetFramework>()?.MaxEquippedPets ?? 0;
	private int EquippedCount => Inventory?.GetEquippedSlotIndexes().Count ?? 0;
	private int InventoryPetCount => Inventory?.Count ?? 0;
	private int InventoryCapacity => Inventory?.InventorySize ?? 0;
	private List<PetViewModel> AllPets => BuildPetList();
	private List<PetViewModel> EquippedPets => AllPets.Where( pet => pet.IsEquipped ).ToList();
	private bool ShouldShowScrollbar => PetGridPanel?.HasScrollY ?? AllPets.Count > 12;
	private string ScrollbarThumbStyle => $"top: {GetScrollbarThumbTop()}%; height: {GetScrollbarThumbHeight()}%;";
	private bool IsDeletingPet => deletingSlotIndex >= 0;
	private string DeleteToggleClass => $"pet-delete-toggle {(isDeleteMode ? "active" : "")}";
	private string SortDirectionText => sortMode == PetInventorySortMode.Name
		? sortAscending ? "A to Z" : "Z to A"
		: sortAscending ? "Low to High" : "High to Low";

	public override void Tick()
	{
		base.Tick();

		if ( !IsOpen )
			return;

		var shouldUpdate = false;
		if ( IsDeletingPet )
		{
			deleteAnimationTime = Time.Now - deleteStartTime;
			if ( deleteAnimationTime >= DeleteAnimationDuration )
			{
				FinishDeletePet();
				return;
			}

			shouldUpdate = true;
		}

		if ( isDeleteMode )
		{
			shouldUpdate = true;
		}

		if ( isDeleteModeSettling )
		{
			deleteModeSettleTime = Time.Now - deleteModeSettleStartTime;
			if ( deleteModeSettleTime >= DeleteModeSettleDuration )
			{
				isDeleteModeSettling = false;
				deleteModeSettleTime = 0f;
			}

			shouldUpdate = true;
		}

		if ( sortAnimationTime < SortAnimationDuration )
		{
			sortAnimationTime = Time.Now - sortAnimationStartTime;
			shouldUpdate = true;
		}

		if ( PetGridPanel != null )
		{
			var scrollRatio = GetScrollRatio();
			var thumbHeight = GetScrollbarThumbHeight();
			if ( MathF.Abs( scrollRatio - lastScrollRatio ) > 0.005f || MathF.Abs( thumbHeight - lastThumbHeight ) > 0.5f )
			{
				lastScrollRatio = scrollRatio;
				lastThumbHeight = thumbHeight;
				shouldUpdate = true;
			}
		}

		if ( shouldUpdate )
		{
			StateHasChanged();
		}
	}

	private void Close()
	{
		isDeleteMode = false;
		isDeleteModeSettling = false;
		pendingDeleteSlotIndex = -1;

		if ( IsDeletingPet )
			return;

		CloseRequested?.Invoke();
	}

	private void TogglePet( int slotIndex )
	{
		if ( isDeleteMode || IsDeletingPet )
			return;

		Inventory?.TogglePetEquipped( slotIndex );
		StateHasChanged();
	}

	private void ToggleDeleteMode()
	{
		if ( IsDeletingPet )
			return;

		if ( isDeleteMode )
		{
			isDeleteMode = false;
			isDeleteModeSettling = true;
			deleteModeSettleStartTime = Time.Now;
			deleteModeSettleTime = 0f;
		}
		else
		{
			isDeleteMode = true;
			isDeleteModeSettling = false;
			deleteModeSettleTime = 0f;
		}

		pendingDeleteSlotIndex = -1;
		StateHasChanged();
	}

	private void SetSortMode( PetInventorySortMode mode )
	{
		if ( sortMode == mode )
			return;

		sortMode = mode;
		pendingDeleteSlotIndex = -1;
		StartSortAnimation();
		StateHasChanged();
	}

	private void ToggleSortDirection()
	{
		sortAscending = !sortAscending;
		pendingDeleteSlotIndex = -1;
		StartSortAnimation();
		StateHasChanged();
	}

	private void StartSortAnimation()
	{
		sortAnimationStartTime = Time.Now;
		sortAnimationTime = 0f;
	}

	private void HandlePetCardClicked( int slotIndex )
	{
		if ( IsDeletingPet )
			return;

		if ( !isDeleteMode )
		{
			TogglePet( slotIndex );
			return;
		}

		if ( pendingDeleteSlotIndex != slotIndex )
		{
			pendingDeleteSlotIndex = slotIndex;
			StateHasChanged();
			return;
		}

		deletingSlotIndex = slotIndex;
		deleteStartTime = Time.Now;
		deleteAnimationTime = 0f;
		pendingDeleteSlotIndex = -1;
		StateHasChanged();
	}

	private void FinishDeletePet()
	{
		var slotIndex = deletingSlotIndex;
		deletingSlotIndex = -1;
		deleteAnimationTime = 0f;
		pendingDeleteSlotIndex = -1;

		if ( Inventory?.RemovePet( slotIndex ) == true )
		{
			isDeleteMode = true;
			isDeleteModeSettling = false;
			deleteModeSettleTime = 0f;
		}

		StateHasChanged();
	}

	private void BeginDeleteModeSettle()
	{
		isDeleteMode = false;
		isDeleteModeSettling = true;
		deleteModeSettleStartTime = Time.Now;
		deleteModeSettleTime = 0f;
		pendingDeleteSlotIndex = -1;
	}

	private string GetPetCardClass( PetViewModel pet )
	{
		var classes = pet.IsEquipped ? $"pet-card equipped {pet.RarityClass}" : $"pet-card {pet.RarityClass}";
		if ( isDeleteMode )
			classes += " delete-mode";
		if ( pendingDeleteSlotIndex == pet.SlotIndex )
			classes += " pending-delete";
		if ( deletingSlotIndex == pet.SlotIndex )
			classes += " deleting";

		return classes;
	}

	private string GetSortButtonClass( PetInventorySortMode mode )
	{
		return $"pet-sort-button {(sortMode == mode ? "active" : "")}";
	}

	private string GetEquippedPetCardClass( PetViewModel pet )
	{
		return $"pet-equipped-card {pet.RarityClass}";
	}

	private string GetPetCardStyle( PetViewModel pet )
	{
		var backgroundColor = pet.IsEquipped ? "#54c943" : "#37adf4";
		var opacity = 1f;
		var transform = "translateX(0px) translateY(0px) rotate(0deg) scale(1)";
		var width = 150f;
		var height = 176f;
		var marginRight = 0f;
		var sortOffset = GetSortAnimationOffset( pet.DisplayIndex );

		if ( isDeleteMode || isDeleteModeSettling )
		{
			var shake = GetDeleteModeShake( pet.SlotIndex );
			transform = $"translateX({shake.x:0.##}px) translateY({shake.y:0.##}px) rotate({shake.rotation:0.##}deg) scale(1)";
			sortOffset = 0f;
		}
		else if ( sortOffset > 0f )
		{
			var y = sortOffset * 12f;
			var scale = 0.96f + ((1f - sortOffset) * 0.04f);
			transform = $"translateX(0px) translateY({y:0.##}px) rotate(0deg) scale({scale:0.###})";
			opacity = 1f - (sortOffset * 0.34f);
		}

		if ( isDeleteMode )
		{
			backgroundColor = pendingDeleteSlotIndex == pet.SlotIndex
				? "rgba(236, 36, 48, 0.5)"
				: "rgba(255, 255, 255, 0.9)";
		}

		if ( deletingSlotIndex == pet.SlotIndex )
		{
			var deleteStyle = GetDeleteAnimationValues();
			backgroundColor = "rgba(255, 255, 255, 0.96)";
			transform = deleteStyle.transform;
			opacity = deleteStyle.opacity;
			width = deleteStyle.width;
			height = deleteStyle.height;
			marginRight = deleteStyle.marginRight;
		}

		return $"{pet.RarityBorderStyle} width: {width:0.##}px; height: {height:0.##}px; margin-right: {marginRight:0.##}px; background-color: {backgroundColor}; opacity: {opacity:0.###}; transform: {transform};";
	}

	private string GetStatusText( PetViewModel pet )
	{
		if ( !pet.IsEquipped && IsMaxPetsEquipped )
			return "";

		return pet.IsEquipped ? "" : "";
	}

	private string GetHoverActionText( PetViewModel pet )
	{
		if ( deletingSlotIndex == pet.SlotIndex )
			return "";

		if ( isDeleteMode )
			return pendingDeleteSlotIndex == pet.SlotIndex ? "Are you sure?" : "Delete";

		if ( !pet.IsEquipped && IsMaxPetsEquipped )
			return "Max pets equipped";

		return pet.IsEquipped ? "Unequip" : "Equip";
	}

	private string GetPetActionOverlayClass( PetViewModel pet )
	{
		if ( isDeleteMode )
			return "pet-action-overlay delete";

		if ( !pet.IsEquipped && IsMaxPetsEquipped )
			return "pet-action-overlay max-equipped";

		return pet.IsEquipped ? "pet-action-overlay unequip" : "pet-action-overlay equip";
	}

	private (float x, float y, float rotation) GetDeleteModeShake( int slotIndex )
	{
		if ( (!isDeleteMode && !isDeleteModeSettling) || deletingSlotIndex == slotIndex )
			return (0f, 0f, 0f);

		var amplitude = isDeleteMode
			? 1f
			: 1f - Smooth01( (deleteModeSettleTime / DeleteModeSettleDuration).Clamp( 0f, 1f ) );
		var time = Time.Now + (slotIndex * 0.37f);
		return (
			MathF.Sin( time * 24f ) * 1.25f * amplitude,
			MathF.Cos( time * 21f ) * 0.95f * amplitude,
			MathF.Sin( time * 27f ) * 1.45f * amplitude
		);
	}

	private (string transform, float opacity, float width, float height, float marginRight) GetDeleteAnimationValues()
	{
		var t = Smooth01( (deleteAnimationTime / DeleteAnimationDuration).Clamp( 0f, 1f ) );
		var collapse = Smooth01( ((deleteAnimationTime / DeleteAnimationDuration) - DeleteCollapseStart) / (1f - DeleteCollapseStart) );
		var hop = -MathF.Sin( t * MathF.PI ) * 72f;
		var shrink = 1f - (t * 0.92f);
		var spin = t * 560f;
		var opacity = 1f - (t * 0.92f);
		var width = MathF.Max( 0f, 150f * (1f - collapse) );
		var height = MathF.Max( 0f, 176f * (1f - collapse) );
		var marginRight = -14f * collapse;

		return ($"translateX(0px) translateY({hop:0.##}px) rotate({spin:0.##}deg) scale({shrink:0.###})", opacity, width, height, marginRight);
	}

	private static float Smooth01( float value )
	{
		var t = value.Clamp( 0f, 1f );
		return t * t * (3f - (2f * t));
	}

	private bool IsMaxPetsEquipped => MaxEquipped > 0 && EquippedCount >= MaxEquipped;

	private float GetScrollRatio()
	{
		if ( PetGridPanel == null || PetGridPanel.ScrollSize.y <= 0f )
			return 0f;

		return (PetGridPanel.ScrollOffset.y / PetGridPanel.ScrollSize.y).Clamp( 0f, 1f );
	}

	private float GetScrollbarThumbHeight()
	{
		if ( PetGridPanel == null || PetGridPanel.Box.Rect.Height <= 0f )
			return 32f;

		var contentHeight = PetGridPanel.Box.Rect.Height + PetGridPanel.ScrollSize.y;
		if ( contentHeight <= 0f )
			return 100f;

		return MathF.Max( 12f, PetGridPanel.Box.Rect.Height / contentHeight * 100f );
	}

	private float GetScrollbarThumbTop()
	{
		var thumbHeight = GetScrollbarThumbHeight();
		var trackRange = MathF.Max( 0f, 100f - thumbHeight );
		return GetScrollRatio() * trackRange;
	}

	private List<PetViewModel> BuildPetList()
	{
		var pets = new List<PetViewModel>();
		var inventory = Inventory;
		if ( inventory == null )
			return pets;

		for ( var i = 0; i < inventory.Slots.Count; i++ )
		{
			var slot = inventory.GetPet( i );
			if ( !slot.IsValid() )
				continue;

			var petPrefab = slot.GetPetPrefab();
			var petComponent = petPrefab?.GetComponent<PetComponent>() ?? petPrefab?.GetComponentInChildren<PetComponent>();
			var displayName = !string.IsNullOrWhiteSpace( petComponent?.DisplayName ) ? petComponent.DisplayName : slot.DisplayName;
			var previewTexture = PetPreviewRenderer.Instance?.GetPreviewTexture( slot.PetPrefabPath, petPrefab );

			pets.Add( new PetViewModel
			{
				SlotIndex = i,
				DisplayName = string.IsNullOrWhiteSpace( displayName ) ? "Pet" : displayName,
				IsEquipped = inventory.IsPetEquipped( i ),
				Rarity = slot.Rarity,
				CoinMultiplier = MathF.Max( 0f, petComponent?.CoinMultiplier ?? 1f ) * slot.RarityValueMultiplier,
				Damage = Math.Max( 0, (int)MathF.Round( (petComponent?.Damage ?? 1) * slot.RarityValueMultiplier ) ),
				PreviewTexture = previewTexture
			} );
		}

		pets = SortPets( pets );
		for ( var i = 0; i < pets.Count; i++ )
		{
			pets[i].DisplayIndex = i;
		}

		return pets;
	}

	private List<PetViewModel> SortPets( List<PetViewModel> pets )
	{
		IOrderedEnumerable<PetViewModel> sorted = sortMode switch
		{
			PetInventorySortMode.Name => sortAscending
				? pets.OrderBy( pet => pet.DisplayName, StringComparer.OrdinalIgnoreCase ).ThenBy( pet => (int)pet.Rarity ).ThenBy( pet => pet.SlotIndex )
				: pets.OrderByDescending( pet => pet.DisplayName, StringComparer.OrdinalIgnoreCase ).ThenByDescending( pet => (int)pet.Rarity ).ThenBy( pet => pet.SlotIndex ),
			_ => sortAscending
				? pets.OrderBy( pet => (int)pet.Rarity ).ThenBy( pet => pet.DisplayName, StringComparer.OrdinalIgnoreCase ).ThenBy( pet => pet.SlotIndex )
				: pets.OrderByDescending( pet => (int)pet.Rarity ).ThenBy( pet => pet.DisplayName, StringComparer.OrdinalIgnoreCase ).ThenBy( pet => pet.SlotIndex )
		};

		return sorted.ToList();
	}

	private float GetSortAnimationOffset( int displayIndex )
	{
		if ( sortAnimationTime >= SortAnimationDuration )
			return 0f;

		var stagger = MathF.Min( displayIndex, 18 ) * 0.012f;
		var t = ((sortAnimationTime - stagger) / SortAnimationDuration).Clamp( 0f, 1f );
		return 1f - Smooth01( t );
	}

	protected override int BuildHash()
	{
		var inventory = Inventory;
		var slotHash = 0;
		if ( inventory != null )
		{
			foreach ( var slot in inventory.Slots )
			{
				var petPrefab = slot?.GetPetPrefab();
				var petComponent = petPrefab?.GetComponent<PetComponent>() ?? petPrefab?.GetComponentInChildren<PetComponent>();
				slotHash = HashCode.Combine( slotHash, slot?.DisplayName, slot?.PetPrefabPath, slot?.Rarity, petComponent?.DisplayName );
			}

			foreach ( var equippedSlotIndex in inventory.GetEquippedSlotIndexes() )
			{
				slotHash = HashCode.Combine( slotHash, equippedSlotIndex );
			}
		}

		var deleteStateHash = HashCode.Combine( isDeleteMode, isDeleteModeSettling, pendingDeleteSlotIndex, deletingSlotIndex, (int)(deleteAnimationTime * 30f), (int)(deleteModeSettleTime * 30f) );
		var sortStateHash = HashCode.Combine( sortMode, sortAscending, (int)(sortAnimationTime * 30f), PetPreviewRenderer.PreviewVersion );
		var uiStateHash = HashCode.Combine( deleteStateHash, sortStateHash );
		return HashCode.Combine( IsOpen, inventory?.Count ?? 0, EquippedCount, MaxEquipped, slotHash, lastScrollRatio, lastThumbHeight, uiStateHash );
	}

	private enum PetInventorySortMode
	{
		Rarity,
		Name
	}

	private sealed class PetViewModel
	{
		public int SlotIndex { get; set; }
		public int DisplayIndex { get; set; }
		public string DisplayName { get; set; }
		public bool IsEquipped { get; set; }
		public PetRarity Rarity { get; set; }
		public float CoinMultiplier { get; set; }
		public int Damage { get; set; }
		public Texture PreviewTexture { get; set; }
		public string IconText => string.IsNullOrWhiteSpace( DisplayName ) ? "?" : DisplayName[..1].ToUpperInvariant();
		public string CoinMultiplierText => CoinMultiplier.ToString( "0.##" );
		public string RarityClass => Rarity.GetCssClass();
		public string RarityBorderStyle => $"border-color: {Rarity.GetCssColor()};";
	}
}
