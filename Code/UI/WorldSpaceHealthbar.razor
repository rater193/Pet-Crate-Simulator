@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<style>
    .title {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translateX(-50%) translateY(-32px);
        font-size: 64px;
        color: white;
    }

    .healthbarBackground {
        background-color: red;
        position: absolute;
        left: 32px;
        right: 32px;
        top: 50%;
        height: 64px;
        transform: translateY(-50%);
        border-radius: 100%;
    }

    .healthbarForeground {
        border-radius: 100%;
        background-color: green;
        position: relative;
        left: 0px;
        top: 0px;
        height: 100%;
        transition: width 0.15s ease;
    }
</style>

<root>
    @if(ShouldShowHealthBar ) {
    <div class="healthbarBackground">
        <div class="title">@HealthPercent%</div>
        <div class="healthbarForeground" style="width: @(WidthPercent)%;"></div>
    </div>
    }
</root>

@code
{
    [Property, TextArea] public string MyStringValue { get; set; } = "Hello World!";
    [Property, Sync] public int health { get; set; } = 100;
    [Property, Sync] public int maxHealth { get; set; } = 100;

    public bool ShouldShowHealthBar
    {
        get
        {
            return health < maxHealth ? true : false;
        }
    }


    private int HealthPercent {
        get
        {
            return (int)((float)health / (float)maxHealth * 100f).Clamp(0f, 100f);
        }
    }

    private float WidthPercent
    {
        get
        {
            if (maxHealth <= 0)
                return 0f;

            return 8f+(92f*((float)health / (float)maxHealth));
        }
    }


    protected override void OnEnabled()
    {
        FaceCamera();
    }

    protected override void OnStart()
    {
        FaceCamera();
    }

    protected override void OnUpdate()
    {
        FaceCamera();
    }

    public void FaceCamera()
    {
        if ( Scene?.Camera.IsValid() != true )
            return;

        GameObject.WorldRotation = Scene.Camera.WorldRotation * Rotation.FromYaw(180f);
    }

    protected override int BuildHash()
    {
        return System.HashCode.Combine(MyStringValue, health, maxHealth, WidthPercent, HealthPercent, ShouldShowHealthBar);
    }
}
