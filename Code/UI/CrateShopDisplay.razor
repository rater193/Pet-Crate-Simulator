@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<style>
	.shop-display-root {
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		align-items: center;
		justify-content: center;
		font-family: Poppins;
	}

	.shop-sign {
		width: 1780px;
		height: 1180px;
		background-color: #10243a;
		border: 18px solid #ffd66f;
		border-radius: 48px;
		box-shadow: 0px 18px 0px rgba(70, 42, 7, 0.55);
		position: relative;
		overflow: hidden;
		flex-direction: column;
		align-items: center;
	}

	.shop-sign-inner {
		position: absolute;
		left: 34px;
		top: 34px;
		right: 34px;
		bottom: 34px;
		border: 7px solid rgba(255, 255, 255, 0.22);
		border-radius: 32px;
		pointer-events: none;
	}

	.shop-shimmer {
		position: absolute;
		top: -180px;
		left: -620px;
		width: 420px;
		height: 1500px;
		background-color: rgba(255, 255, 255, 0.12);
		pointer-events: none;
		animation: shop-shimmer-sweep 7s linear infinite;
	}

	.shop-spark {
		position: absolute;
		width: 28px;
		height: 28px;
		border-radius: 6px;
		background-color: #ffffff;
		opacity: 0.5;
		pointer-events: none;
		animation: shop-spark-pulse 1.3s ease-in-out infinite alternate;
	}

	.shop-spark.one {
		left: 130px;
		top: 115px;
		background-color: #88f7ff;
	}

	.shop-spark.two {
		right: 170px;
		top: 135px;
		background-color: #ff86b0;
		animation-duration: 1.6s;
		animation-delay: 0.4s;
	}

	.shop-spark.three {
		left: 50%;
		bottom: 95px;
		background-color: #ffe98c;
		animation-name: shop-spark-pulse-center;
		animation-duration: 1.1s;
		animation-delay: 0.8s;
	}

	.shop-title {
		margin-top: 74px;
		color: #fff4b8;
		font-size: 118px;
		font-weight: 900;
		text-align: center;
		text-shadow: 0px 8px 0px rgba(75, 33, 10, 0.85), 0px 0px 18px rgba(255, 221, 105, 0.32);
		letter-spacing: 0px;
		z-index: 3;
		animation: shop-title-bob 1.45s ease-in-out infinite alternate;
	}

	.shop-subtitle {
		margin-top: 2px;
		color: #aeeeff;
		font-size: 34px;
		font-weight: 900;
		text-shadow: 0px 4px 0px rgba(0, 0, 0, 0.45);
		z-index: 3;
	}

	.pet-index-grid {
		margin-top: 54px;
		width: 1500px;
		height: 760px;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 34px;
		z-index: 4;
	}

	.pet-index-card-wrapper {
		pointer-events: all;
		cursor: pointer;
		transition: transform 0.12s ease-out;
	}

	.pet-index-card-wrapper:hover {
		transform: scale(1.08);
	}

	.pet-index-card-wrapper:hover .pet-index-card {
		outline-color: #ffd66f;
	}

	.pet-index-card {
		width: 420px;
		height: 336px;
		border-radius: 34px;
		background-color: rgba(31, 180, 218, 0.94);
		border: 9px solid #ffffff;
		box-shadow: 0px 12px 0px rgba(0, 53, 78, 0.42);
		outline: 6px solid rgba(255, 214, 111, 0);
		outline-offset: 5px;
		position: relative;
		overflow: hidden;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		transition: border-color 0.15s ease, outline-color 0.12s ease-out;
		animation: pet-card-bob 1.6s ease-in-out infinite alternate;
	}

	.pet-index-card.trashed {
		border-color: #d92d3d;
	}

	.pet-index-card.locked {
		background-color: rgba(42, 55, 71, 0.96);
		border-color: rgba(255, 255, 255, 0.62);
		box-shadow: 0px 12px 0px rgba(0, 0, 0, 0.34);
	}

	.pet-index-card.uncommon {
		background-color: rgba(50, 194, 112, 0.94);
	}

	.pet-index-card.rare {
		background-color: rgba(69, 130, 235, 0.94);
	}

	.pet-index-card.epic {
		background-color: rgba(177, 91, 239, 0.94);
	}

	.pet-index-card.legendary {
		background-color: rgba(245, 160, 54, 0.96);
	}

	.pet-index-glow {
		position: absolute;
		left: -70px;
		top: -110px;
		width: 560px;
		height: 250px;
		background-color: rgba(255, 255, 255, 0.16);
		transform: rotate(-11deg);
		pointer-events: none;
	}

	.pet-index-preview-frame {
		width: 214px;
		height: 214px;
		border-radius: 28px;
		background-color: rgba(255, 255, 255, 0.18);
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		animation: pet-icon-pulse 1.2s ease-in-out infinite alternate;
	}

	.pet-index-preview {
		width: 196px;
		height: 196px;
	}

	.pet-index-preview.locked {
		filter-brightness: 0;
		filter-tint: #02070d;
		opacity: 0.9;
	}

	.pet-index-letter {
		color: white;
		font-size: 106px;
		font-weight: 900;
		text-shadow: 0px 6px 0px rgba(0, 0, 0, 0.28);
	}

	.pet-index-letter.locked {
		color: #05070d;
		text-shadow: none;
	}

	.pet-index-name {
		margin-top: 14px;
		color: #ffffff;
		font-size: 32px;
		font-weight: 900;
		text-align: center;
		text-shadow: 0px 4px 0px rgba(0, 0, 0, 0.3);
		max-width: 360px;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.pet-index-name.locked {
		color: rgba(255, 255, 255, 0.78);
	}

	.pet-index-chance {
		margin-top: 4px;
		color: #fff4b8;
		font-size: 30px;
		font-weight: 900;
		text-align: center;
		text-shadow: 0px 3px 0px rgba(0, 0, 0, 0.38);
	}

	.pet-index-empty {
		color: #ffffff;
		font-size: 48px;
		font-weight: 900;
		text-align: center;
		text-shadow: 0px 4px 0px rgba(0, 0, 0, 0.35);
	}

	.pet-index-trash-overlay {
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		background-color: rgba(217, 45, 61, 0.42);
		pointer-events: none;
		z-index: 6;
	}

	.pet-index-trash-icon {
		width: 118px;
		height: 118px;
	}

	.pet-index-trash-text {
		margin-top: 10px;
		color: #ffffff;
		font-size: 42px;
		font-weight: 900;
		text-shadow: 0px 4px 0px rgba(0, 0, 0, 0.45);
	}

	/* All looping motion is pure CSS now, so the panel never rebuilds for animation
	   (no per-frame StateHasChanged or hash churn). Keyframes are escaped for Razor. */
	@@keyframes shop-title-bob {
		0% { transform: translateY(-8px) scale(0.984); }
		100% { transform: translateY(8px) scale(1.018); }
	}

	@@keyframes shop-shimmer-sweep {
		0% { transform: rotate(16deg) translateX(0px); }
		50% { transform: rotate(16deg) translateX(2400px); }
		100% { transform: rotate(16deg) translateX(0px); }
	}

	@@keyframes shop-spark-pulse {
		0% { opacity: 0.30; transform: rotate(45deg) scale(0.62); }
		100% { opacity: 0.72; transform: rotate(45deg) scale(1.05); }
	}

	@@keyframes shop-spark-pulse-center {
		0% { opacity: 0.30; transform: translateX(-50%) rotate(45deg) scale(0.62); }
		100% { opacity: 0.72; transform: translateX(-50%) rotate(45deg) scale(1.05); }
	}

	@@keyframes pet-card-bob {
		0% { transform: translateY(-10px) rotate(-2.2deg); }
		100% { transform: translateY(10px) rotate(2.2deg); }
	}

	@@keyframes pet-icon-pulse {
		0% { transform: scale(0.985); }
		100% { transform: scale(1.03); }
	}
</style>

<root>
	<div class="shop-display-root">
		<div class="shop-sign">
			<div class="shop-sign-inner"></div>
			<div class="shop-shimmer"></div>
			<div class="shop-spark one"></div>
			<div class="shop-spark two"></div>
			<div class="shop-spark three"></div>
			<div class="shop-title">@TitleText</div>
			<div class="shop-subtitle">@SubtitleText</div>
			<div class="pet-index-grid">
				@{
					var entries = PetIndexEntries;
				}
				@if ( entries.Count == 0 )
				{
					<div class="pet-index-empty">Configure crate pets here</div>
				}
				else
				{
					@for ( var i = 0; i < entries.Count; i++ )
					{
						var pet = entries[i];
						<div class="pet-index-card-wrapper" onmousedown=@(() => ToggleTrash( pet.PrefabPath )) onmouseover=@(() => SetHoverPrompt( HoverActionLabel )) onmouseout=@(() => SetHoverPrompt( string.Empty ))>
							<div class="@pet.CardClass" style="@pet.CardStyle">
								<div class="pet-index-glow"></div>
								<div class="pet-index-preview-frame" style="@pet.IconStyle">
									@if ( pet.PreviewTexture != null )
									{
										<Image class="@pet.PreviewClass" Texture=@pet.PreviewTexture />
									}
									else
									{
										<div class="@pet.LetterClass">@pet.IconText</div>
									}
								</div>
								<div class="@pet.NameClass">@pet.DisplayName</div>
								<div class="pet-index-chance">@pet.ChanceText</div>
								@if ( pet.Trashed )
								{
									<div class="pet-index-trash-overlay">
										<img class="pet-index-trash-icon" src="ui/icons/icon_trashcan.vtex" />
										<div class="pet-index-trash-text">Auto-Trash</div>
									</div>
								}
							</div>
						</div>
					}
				}
			</div>
		</div>
	</div>
</root>

@code
{
	[Property] public string TitleText { get; set; } = "Crate Shop";
	[Property] public string SubtitleText { get; set; } = "Pet Index";
	[Property] public List<InteractBuyCrate.PetCrateReward> FeaturedPets { get; set; } = new();
	[Property] public float PetSwapInterval { get; set; } = 6f;
	[Property] public bool AutoUseCrateRewards { get; set; } = true;
	[Property] public string HoverActionLabel { get; set; } = "Toggle";

	// How often discovery/preview state is re-evaluated. Animation is pure CSS, so this is the
	// ONLY thing that triggers a (cheap, throttled) rebuild now.
	private const float DiscoveryRefreshInterval = 1f;

	// Cached entry list — built only when something actually changes, not every frame.
	private List<PetIndexEntry> cachedEntries = new();
	private int contentVersion;
	private int lastTrashVersion = -1;
	private int lastPreviewVersion = -1;
	private float discoveryTimer;

	private List<PetIndexEntry> PetIndexEntries => cachedEntries;

	// Client-local, shared across all shop displays: pets the player has flagged to auto-trash
	// instead of receiving them from crates. Keyed by pet prefab path.
	private static readonly HashSet<string> trashedPetPaths = new( StringComparer.OrdinalIgnoreCase );
	public static int TrashVersion { get; private set; }

	public static bool IsPetTrashed( string prefabPath )
	{
		return !string.IsNullOrWhiteSpace( prefabPath ) && trashedPetPaths.Contains( prefabPath );
	}

	public static void SetPetTrashed( string prefabPath, bool trashed )
	{
		if ( string.IsNullOrWhiteSpace( prefabPath ) )
			return;

		var changed = trashed ? trashedPetPaths.Add( prefabPath ) : trashedPetPaths.Remove( prefabPath );
		if ( changed )
			TrashVersion++;
	}

	private void ToggleTrash( string prefabPath )
	{
		SetPetTrashed( prefabPath, !IsPetTrashed( prefabPath ) );
		RebuildEntries();
	}

	// Prompt text shown in the HUD (below the cursor) while a pet card is hovered.
	public static string HoverPromptText { get; private set; } = string.Empty;
	public static int HoverPromptVersion { get; private set; }

	private static void SetHoverPrompt( string text )
	{
		text ??= string.Empty;
		if ( HoverPromptText == text )
			return;

		HoverPromptText = text;
		HoverPromptVersion++;
	}

	protected override void OnStart()
	{
		lastTrashVersion = TrashVersion;
		lastPreviewVersion = PetPreviewRenderer.PreviewVersion;
		discoveryTimer = DiscoveryRefreshInterval;
		RebuildEntries();
	}

	protected override void OnUpdate()
	{
		// Cheap per-frame checks only; the heavy rebuild runs at most ~once a second or when
		// the player flags a pet for auto-trash / a preview texture finishes rendering.
		var rebuild = false;

		if ( lastTrashVersion != TrashVersion )
		{
			lastTrashVersion = TrashVersion;
			rebuild = true;
		}

		if ( lastPreviewVersion != PetPreviewRenderer.PreviewVersion )
		{
			lastPreviewVersion = PetPreviewRenderer.PreviewVersion;
			rebuild = true;
		}

		discoveryTimer -= Time.Delta;
		if ( discoveryTimer <= 0f )
		{
			discoveryTimer = DiscoveryRefreshInterval;
			rebuild = true;
		}

		if ( rebuild )
			RebuildEntries();
	}

	private void RebuildEntries()
	{
		cachedEntries = BuildPetIndexEntries();
		contentVersion++;
		StateHasChanged();
	}

	public List<InteractBuyCrate.PetCrateReward> GetConfiguredRewards()
	{
		return FeaturedPets?
			.Where( reward => reward != null && reward.PetPrefab.IsValid() && reward.SpawnWeight > 0f )
			.ToList() ?? new List<InteractBuyCrate.PetCrateReward>();
	}

	private List<PetIndexEntry> BuildPetIndexEntries()
	{
		var rewards = MergeRewardsByPet( GetConfiguredRewards() );

		if ( rewards.Count == 0 && AutoUseCrateRewards )
		{
			rewards = MergeRewardsByPet( GetNearbyCrateRewards() );
		}

		var totalWeight = MathF.Max( 0.001f, rewards.Sum( reward => MathF.Max( 0f, reward.SpawnWeight ) ) );
		var entries = new List<PetIndexEntry>();

		for ( var i = 0; i < rewards.Count; i++ )
		{
			var reward = rewards[i];
			var prefab = reward.PetPrefab;
			var displayName = GetPetDisplayName( prefab );
			var prefabPath = GetPetPrefabPath( prefab );
			var discovered = HasDiscoveredPet( displayName, prefabPath );
			var chance = Math.Clamp( MathF.Max( 0f, reward.SpawnWeight ) / totalWeight * 100f, 0f, 100f );

			entries.Add( new PetIndexEntry
			{
				DisplayName = discovered ? displayName : "???",
				PrefabPath = prefabPath,
				PreviewTexture = PetPreviewRenderer.Instance?.GetPreviewTexture( prefabPath, prefab ),
				Rarity = reward.Rarity,
				Discovered = discovered,
				Trashed = IsPetTrashed( prefabPath ),
				Chance = chance,
				// Static per-card animation offsets so the CSS bob/pulse aren't all in sync.
				// These only change when the list rebuilds (~1s), not per frame.
				CardStyle = $"animation-delay: {i * 0.13f:0.##}s;",
				IconStyle = $"animation-delay: {i * 0.17f:0.##}s;"
			} );
		}

		return entries;
	}

	private static List<InteractBuyCrate.PetCrateReward> MergeRewardsByPet( IEnumerable<InteractBuyCrate.PetCrateReward> rewards )
	{
		if ( rewards == null )
			return new List<InteractBuyCrate.PetCrateReward>();

		return rewards
			.Where( reward => reward != null && reward.PetPrefab.IsValid() && reward.SpawnWeight > 0f )
			.GroupBy( reward => GetPetPrefabPath( reward.PetPrefab ) )
			.Select( group =>
			{
				var first = group.First();
				return new InteractBuyCrate.PetCrateReward
				{
					Rarity = group.Max( reward => reward.Rarity ),
					SpawnWeight = group.Sum( reward => MathF.Max( 0f, reward.SpawnWeight ) ),
					PetPrefab = first.PetPrefab
				};
			} )
			.ToList();
	}

	private List<InteractBuyCrate.PetCrateReward> GetNearbyCrateRewards()
	{
		var results = new List<InteractBuyCrate.PetCrateReward>();
		if ( GameObject.IsValid() )
		{
			var parent = GameObject.Parent;
			if ( parent.IsValid() )
			{
				foreach ( var crate in parent.GetAllObjects( true ).Select( obj => obj.GetComponent<InteractBuyCrate>() ).Where( crate => crate != null ) )
				{
					results.AddRange( crate.Pets.Where( reward => reward != null && reward.PetPrefab.IsValid() && reward.SpawnWeight > 0f ) );
				}
			}
		}

		return results;
	}

	private static bool HasDiscoveredPet( string displayName, string prefabPath )
	{
		var petKey = GameStatsTracker.ToStatKeySuffix( displayName, "unknown_pet" );
		if ( GetLocalStatSum( $"pets_added_{petKey}" ) > 0 || GetLocalStatSum( $"pet_added_{petKey}" ) > 0 || GetLocalStatSum( $"pets_hatched_{petKey}" ) > 0 )
			return true;

		if ( !string.IsNullOrWhiteSpace( displayName ) && GetLocalStatSum( displayName ) > 0 )
			return true;

		return HasPetInInventory( displayName, prefabPath );
	}

	private static double GetLocalStatSum( string statName )
	{
		if ( string.IsNullOrWhiteSpace( statName ) )
			return 0;

		try
		{
			return Stats.LocalPlayer.Get( statName ).Sum;
		}
		catch ( Exception exception )
		{
			Log.Warning( exception, $"Failed to read local stat '{statName}'." );
			return 0;
		}
	}

	private static bool HasPetInInventory( string displayName, string prefabPath )
	{
		var inventory = PlayerData.LOCALDATA?.inventory ?? PlayerData.LOCALDATA?.GetComponent<global::Inventory>();
		if ( inventory == null )
			return false;

		return inventory.Slots.Any( slot =>
			slot.IsValid()
			&& slot.HasPet
			&& (string.Equals( slot.DisplayName, displayName, StringComparison.OrdinalIgnoreCase )
				|| string.Equals( slot.PetPrefabPath, prefabPath, StringComparison.OrdinalIgnoreCase )) );
	}

	private static string GetPetDisplayName( GameObject petPrefab )
	{
		var component = petPrefab.GetComponent<PetComponent>() ?? petPrefab.GetComponentInChildren<PetComponent>();
		if ( !string.IsNullOrWhiteSpace( component?.DisplayName ) )
			return component.DisplayName;

		return petPrefab.IsValid() && !string.IsNullOrWhiteSpace( petPrefab.Name ) ? petPrefab.Name : "Pet";
	}

	private static string GetPetPrefabPath( GameObject petPrefab )
	{
		if ( !string.IsNullOrWhiteSpace( petPrefab.PrefabInstanceSource ) )
			return petPrefab.PrefabInstanceSource;

		return petPrefab.IsValid() && !string.IsNullOrWhiteSpace( petPrefab.Name ) ? petPrefab.Name : "Pet";
	}

	// Cheap and stable: only changes when the cached entry list is rebuilt (trash/preview/discovery).
	protected override int BuildHash()
	{
		return HashCode.Combine( TitleText, SubtitleText, contentVersion );
	}

	private sealed class PetIndexEntry
	{
		public string DisplayName { get; set; }
		public string PrefabPath { get; set; }
		public Texture PreviewTexture { get; set; }
		public PetRarity Rarity { get; set; }
		public bool Discovered { get; set; }
		public bool Trashed { get; set; }
		public float Chance { get; set; }
		public string CardStyle { get; set; }
		public string IconStyle { get; set; }
		public string ChanceText => $"{Chance:0.00}%";
		public string IconText => string.IsNullOrWhiteSpace( DisplayName ) ? "?" : DisplayName[..1].ToUpperInvariant();
		public string RarityClass => Rarity.ToString().ToLowerInvariant();
		public string CardClass => $"pet-index-card {RarityClass} {(Discovered ? "unlocked" : "locked")}{(Trashed ? " trashed" : "")}";
		public string PreviewClass => $"pet-index-preview {(Discovered ? "unlocked" : "locked")}";
		public string LetterClass => $"pet-index-letter {(Discovered ? "unlocked" : "locked")}";
		public string NameClass => $"pet-index-name {(Discovered ? "unlocked" : "locked")}";
	}
}
